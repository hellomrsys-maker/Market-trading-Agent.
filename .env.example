# OptionAlpha Agent — Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────
# ALPACA PAPER TRADING CREDENTIALS
# Get from: https://alpaca.markets → Paper Trading → API Keys
# ─────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_PAPER_ACCOUNT_ID=your_paper_account_id_here

# ─────────────────────────────────────────────────────────────
# STRATEGY PARAMETERS
# ─────────────────────────────────────────────────────────────
STARTING_CAPITAL=100000
MAX_POSITION_SIZE_PCT=5.0
MAX_OPEN_POSITIONS=10
DAILY_LOSS_LIMIT=2000
MAX_PORTFOLIO_DELTA=500
VIX_CIRCUIT_BREAKER=35.0

# Wheel Strategy
WHEEL_TARGET_CSP_DELTA=0.30
WHEEL_TARGET_CC_DELTA=0.20
WHEEL_MIN_DTE=21
WHEEL_MAX_DTE=45
WHEEL_MIN_PREMIUM_PCT=1.0
WHEEL_PROFIT_TAKE_PCT=50.0
WHEEL_STOP_LOSS_MULT=2.0

# Iron Condor
IC_MIN_IV_RANK=30.0
IC_WING_WIDTH=5
IC_SHORT_DELTA=0.15
IC_MIN_DTE=21
IC_MAX_DTE=45

# Universe of underlyings
TRADING_UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA,AMD,AMZN

# ─────────────────────────────────────────────────────────────
# AI / ML CONFIGURATION (Self-Developed — no external APIs)
# ─────────────────────────────────────────────────────────────
AI_MODEL_DIR=data/models
AI_DEVICE=auto           # auto | cpu | cuda | mps
AI_TRAINING_EPOCHS=200
AI_RL_TIMESTEPS=500000
AI_BATCH_SIZE=256
AI_LEARNING_RATE=3e-4

# ─────────────────────────────────────────────────────────────
# DATABASE & CACHE
# ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/optionalpha.db
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────
# WEB DASHBOARD
# ─────────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_RELOAD=false

# ─────────────────────────────────────────────────────────────
# MARKET SCHEDULE (ET timezone)
# ─────────────────────────────────────────────────────────────
MARKET_OPEN_ET=09:30
MARKET_CLOSE_ET=16:00
MORNING_SCAN_ET=09:40
EXECUTE_ET=10:30
AFTERNOON_REVIEW_ET=14:00
EOD_REVIEW_ET=15:45

# ─────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=data/logs
